{
  "schema_version": "task06-v1-shared-fused-ablation",
  "dataset": "SEED-IV DE-LDS",
  "protocol": "P-I cross-subject single-session LOSO; registered shared-metric interface ablation",
  "variants": ["E0", "E1", "E2", "E3", "E4", "E5"],
  "seeds": [42, 43, 44],
  "epochs": 200,
  "batch_size": 64,
  "learning_rate": 0.001,
  "tau": 0.07,
  "fusion_tau": 0.07,
  "rank": 2,
  "gamma": 0.5,
  "metric_epsilon": 1e-6,
  "lambda_H": 0.0001,
  "weight_decay": 0.0001,
  "fusion_mode": "shared_fused_embedding",
  "head_sharing": "shared",
  "training_path": "fused_uniform_direct",
  "backbone": "e3_strong_de_channel_graph",
  "representation_mode": "cast_level1",
  "classifier_type": "clip",
  "num_classes": 4,
  "sample_length": 3,
  "st_dim": 128,
  "graph_dim": 64,
  "adapter_bottleneck": 32,
  "graph_heads": 4,
  "topk": 6,
  "metric_hidden_dim": 64,
  "dropout": 0.3,
  "va_config": "configs/seediv_va_coordinates.json",
  "normalization": "historical transductive per-subject z-score; identical for all variants",
  "target_labels_used_for_training": false,
  "best_checkpoint_rule": "target_best_accuracy_same_checkpoint_metrics",
  "warning": "Ablation only. Uniform source-side fused supervision approximates the target fused path; source-distance routing remains target-side."
}
